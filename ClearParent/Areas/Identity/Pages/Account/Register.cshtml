@page
@model ClearParent.Areas.Identity.Pages.Account.RegisterModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ Layout = null; }
<!doctype html><html lang="en"><head><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Register — ClearParent</title></head><body><main>
<h1>Create your ClearParent account</h1><div asp-validation-summary="All" role="alert"></div>
@if (!Model.RegistrationAvailable) { <p>Registration is unavailable until email delivery and legal agreements are configured.</p> }
else {
<form method="post">
<p><label asp-for="Input.FirstName">First name</label> <input asp-for="Input.FirstName" autocomplete="given-name" required /></p>
<p><label asp-for="Input.LastName">Last name</label> <input asp-for="Input.LastName" autocomplete="family-name" required /></p>
<p><label asp-for="Input.Email">Email</label> <input asp-for="Input.Email" autocomplete="email" required /></p>
<p><label asp-for="Input.Password">Password</label> <input asp-for="Input.Password" autocomplete="new-password" required /></p>
<p><label asp-for="Input.ConfirmPassword">Confirm password</label> <input asp-for="Input.ConfirmPassword" autocomplete="new-password" required /></p>
<div hidden aria-hidden="true"><label asp-for="Input.Website">Leave this field empty</label><input asp-for="Input.Website" tabindex="-1" autocomplete="off"/></div>
<p><label><input asp-for="Input.AcceptLegal"/> I accept the <a href="@Model.TermsUrl">Terms of Service</a> and <a href="@Model.PrivacyUrl">Privacy Policy</a>.</label></p>
<button type="submit">Register</button></form>
}
<p><a href="/Identity/Account/Login">Sign in</a> <a href="/Identity/Account/ResendEmailConfirmation">Resend email confirmation</a></p>
</main></body></html>
