@using ClearParent.Data
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item"><a class="nav-link" href="/Account/Preferences">My account</a></li>
    <li class="nav-item"><form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/"><button class="nav-link btn btn-link" type="submit">Sign out</button></form></li>
}
else
{
    <li class="nav-item"><a class="nav-link" href="/Identity/Account/Register">Register</a></li>
    <li class="nav-item"><a class="nav-link" href="/Identity/Account/Login">Sign in</a></li>
}
</ul>
