@model ClearParent.Controllers.PreferencesInput
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!doctype html><html lang="en"><head><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Account preferences — ClearParent</title></head><body>
<nav><a href="/Account/Profile">My profile</a> <a href="/Children">Children</a> <a href="/">ClearParent</a> <a href="/Account/Security">Security history</a> <a href="/Identity/Account/Manage">Manage account</a></nav>
<p><a href="/Account/Devices">Devices</a> <a href="/Account/EmailMfa">Email MFA</a> <a href="/Identity/Account/Manage/TwoFactorAuthentication">Authenticator and recovery codes</a></p><h1>Account preferences</h1><p role="status">@TempData["Saved"]</p>
<form method="post" asp-action="Preferences"><div asp-validation-summary="All"></div>
<p><label asp-for="TimeZone">Time zone</label> <input asp-for="TimeZone" required /></p>
<p><label asp-for="Language">Language code</label> <input asp-for="Language" required /></p>
<p><label><input asp-for="AiSuggestions"/> Enable AI suggestions</label></p><button type="submit">Save preferences</button></form>
</body></html>
